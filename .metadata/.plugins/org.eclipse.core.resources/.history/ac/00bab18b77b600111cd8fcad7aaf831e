package InterThreadCommunication;

public class Producer implements Runnable{

	private Thread t;
	private Stock s;
	private Boolean brun;
	
	Public Producer(Stock s) {
		this.t=new Thread(this);
		this.s=s;
		this.brun=true;
		
	}
	
	@Override
	public void run() {
		while(brun) {
			s.produce();
		}
		
	}

	public Thread getT() {
		return t;
	}

	public void setBrun(Boolean brun) {
		this.brun = brun;
	}

		
	

}
